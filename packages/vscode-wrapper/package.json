{
  "name": "myo-vs-code",
  "displayName": "Myo",
  "description": "vscode wrapper around @myo",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "AI"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "myo.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "myo.generateUserStories",
        "title": "Myo: Generate Lean User Stories"
      },
      {
        "command": "myo.generateADR",
        "title": "Myo: Generate ADR Draft"
      },
      {
        "command": "myo.generateC4Diagram",
        "title": "Myo: Generate C4 Diagram"
      },
      {
        "command": "myo.githubAuthenticate",
        "title": "Myo: Authenticate with GitHub"
      },
      {
        "command": "myo.pushStoriesToBacklog",
        "title": "Myo: Push User Stories to GitHub Backlog"
      },
      {
        "command": "myo.fetchIcebox",
        "title": "Myo: Fetch GitHub Icebox Items"
      }
    ],
    "configuration": {
      "title": "Myo",
      "properties": {
        "myo.ollama.url": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "The base URL of the local Ollama server."
        },
        "myo.ollama.model": {
          "type": "string",
          "default": "llama3.1:8b",
          "description": "The Ollama model to use for chat and generation."
        },
        "myo.github.owner": {
          "type": "string",
          "default": "",
          "description": "GitHub username or organization owning the Project v2 board."
        },
        "myo.github.projectNumber": {
          "type": "integer",
          "default": 1,
          "description": "The number of the GitHub Project v2 board (e.g., 1)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.107.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@myo/core": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levizil/Myo.git"
  }
}